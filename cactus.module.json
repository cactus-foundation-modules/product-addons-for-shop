{
  "name": "product-addons-for-shop",
  "version": "0.1.25",
  "tablePrefix": "pad_",
  "description": "Offer real products as add-ons (accessories) on another product's page: matched options, grouped basket lines, per-product pricing and shipping kept intact",
  "requiresCoreVersion": "0.5.1026",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.247"
    },
    {
      "name": "shop-variations",
      "minVersion": "0.1.128"
    }
  ],
  "permissions": [],
  "settingsTabs": [
    {
      "id": "product-addons-for-shop",
      "label": "Product add-ons",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "ProductAddonsSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "product-addons-for-shop",
      "label": "Add-ons",
      "order": 30,
      "permission": "shop.products",
      "import": "./components/admin/AddonsTab",
      "component": "AddonsTab"
    },
    {
      "point": "shop.product-editor-sections",
      "id": "product-addons-inline",
      "label": "Add-ons",
      "order": 52,
      "permission": "shop.products",
      "import": "./components/admin/ProductAddonsSection",
      "component": "ProductAddonsSection"
    },
    {
      "point": "shop.cart-line-resolver",
      "id": "product-addons",
      "import": "./lib/line-resolver",
      "component": "resolveProductAddonLineMeta"
    },
    {
      "point": "shop.cart-line-resolver-prefetch",
      "id": "product-addons",
      "import": "./lib/line-resolver",
      "component": "prefetchProductAddonLines"
    },
    {
      "point": "shop.product-detail-tabs",
      "id": "product-addons-showcase",
      "import": "./lib/detail-tab-provider",
      "component": "productAddonsTabProvider"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopProductAddons",
      "import": "./components/puck/ShopProductAddons",
      "component": "shopProductAddonsPuckComponent",
      "rscComponent": "shopProductAddonsPuckRscComponent",
      "rscImport": "./components/puck/ShopProductAddons.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    },
    {
      "type": "ShopAddonsShowcase",
      "import": "./components/puck/ShopAddonsShowcase",
      "component": "shopAddonsShowcasePuckComponent",
      "rscComponent": "shopAddonsShowcasePuckRscComponent",
      "rscImport": "./components/puck/ShopAddonsShowcase.rsc",
      "layoutTypes": [
        "shopProductDetail"
      ]
    }
  ]
}
